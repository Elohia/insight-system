{
  "id": "insight-system",
  "name": "涟漪意识流 ContextEngine",
  "description": "三层记忆架构：模糊层(~250 tokens) + 精确层(按需) + 深度层(完整)",
  "kind": "context-engine",
  "version": "2.3.0",
  "entry": "index.js",
  "configSchema": {
    "type": "object",
    "properties": {
      "fuzzyBudget": {
        "type": "integer",
        "default": 250,
        "description": "模糊层 token 预算"
      },
      "autoCollectMinTemp": {
        "type": "integer",
        "default": 60,
        "description": "自动收集最低温度"
      }
    }
  }
}
