# 洞见系统环境变量配置示例
# 复制此文件为 .env 并填写你的 API Key

# ========================================
# 必填：智谱 AI API Key（碰撞引擎必需）
# ========================================
# 获取地址：https://open.bigmodel.cn
# 免费额度充足，推荐使用
ZHIPU_API_KEY=your_zhipu_api_key_here

# ========================================
# 可选：阿里云通义千问 API Key（多模态记忆）
# ========================================
# 获取地址：https://dashscope.console.aliyun.com
# 用于文本/图片/视频向量化
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ========================================
# 可选：其他 AI 模型 API Key
# ========================================
# MiniMax
# MINIMAX_API_KEY=your_minimax_api_key_here

# Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# 配置说明
# ========================================
# 1. 至少需要配置一个 API Key
# 2. 推荐使用智谱 GLM-4-Flash（免费额度充足）
# 3. 多模态功能需要阿里云通义千问
# 4. 不要将 .env 文件提交到 Git
# 5. 确保 .env 文件权限为 600

# ========================================
# 如何配置
# ========================================
# 方式一：创建 .env 文件
#   cp .env.example .env
#   nano .env  # 填写你的 API Key
#
# 方式二：使用环境变量
#   export ZHIPU_API_KEY="your_key_here"
#
# 方式三：在代码中设置
#   import os
#   os.environ['ZHIPU_API_KEY'] = 'your_key_here'
